# Hermes Legal Pro — Variables de Entorno
# Copiar a ~/.hermes/.env y completar con tus valores

# ============================================
# MODELO PRINCIPAL (Obligatorio)
# ============================================
# Kimi / Moonshot (Recomendado para español)
KIMI_API_KEY=sk-tu-key-aqui

# ============================================
# MODELOS FALLBACK (Opcional)
# ============================================
# OpenAI Codex (para coding/subagentes)
OPENAI_CODEX_OAUTH=oauth-token-aqui

# NVIDIA (fallback económico)
NVIDIA_API_KEY=nvapi-tu-key-aqui

# ============================================
# GOOGLE (Para Meet y Calendar)
# ============================================
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_CALENDAR_TOKEN=token-de-calendar

# ============================================
# TELEGRAM (Para Gateway)
# ============================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_HOME_CHAT_ID=-1001234567890

# ============================================
# OPCIONALES
# ============================================
# FAL AI (para generación de imágenes/video)
FAL_KEY=fal-key-aqui

# ElevenLabs (para TTS premium)
ELEVENLABS_API_KEY=el-key-aqui

# GitHub (para repos)
GITHUB_TOKEN=ghp_tu-token

# ============================================
# NOTAS
# ============================================
# - Obtén KIMI_API_KEY en: https://platform.moonshot.cn
# - Obtén TELEGRAM_BOT_TOKEN de @BotFather
# - Google OAuth requiere setup en Google Cloud Console
# - Las keys se cargan automáticamente al iniciar Hermes

# Google Workspace Integration
DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_CLIENT_SECRET_PATH=config/client_secret.json
GOOGLE_TOKEN_PATH=config/token.json

# Google Workspace APIs
ENABLE_DRIVE_SYNC=true
ENABLE_CALENDAR_SYNC=true
ENABLE_TASKS_SYNC=true
ENABLE_SHEETS_SYNC=true
ENABLE_DOCS_EXPORT=true
